# --- Core ---
APP_NAME=MindOS API
APP_ENV=development
APP_DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Database (PostgreSQL) ---
# Local dev example:  postgresql+psycopg2://minds:minds@localhost:5432/minds
DATABASE_URL=postgresql+psycopg2://minds:minds@localhost:5432/minds

# --- Auth / JWT ---
# Generate a 32+ char secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GUEST_TOKEN_EXPIRE_MINUTES=1440

# --- Google OAuth ---
# Web client ID from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
